---
/**
 * Hub page for /produk.
 *
 * navLinks.ts gives this section an href, so the site-wide navigation linked
 * here from every page - but no route existed and the link 404'd on all 128
 * pages. /layanan already had src/pages/layanan.astro; this mirrors it exactly
 * rather than inventing a second pattern.
 */
import Layout from '../layouts/Layout.astro';
import IntroPageMenu from '../components/IntroPageMenu.astro';
import { navLinks } from '../data/navLinks';

const pageData = navLinks.find(link => link.href === '/produk');
const title = pageData?.text || 'produk';
const menuItems = pageData?.children;
---
<Layout title={title} description="Produk Solar Nusantara: panel surya TKDN dan impor, inverter on-grid dan off-grid, sistem baterai, ekosistem EV, dan bahan bakar energi biomassa.">
  <IntroPageMenu
    title={title}
    items={menuItems}
    eyebrow="PRODUK & TEKNOLOGI"
    description="Komponen sistem panel surya, infrastruktur ekosistem EV, bahan bakar energi biomassa, dan seri 50100 FG dari SONUS ID."
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: 'Solusi', href: '/layanan' },
      { label: 'Produk' },
    ]}
  />
</Layout>
