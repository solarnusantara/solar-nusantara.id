---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../utils/articles';

const allPosts = await getPublishedArticles();

const pageSize = 6;
const pageCount = Math.ceil(allPosts.length / pageSize);
const posts = allPosts.slice(0, pageSize);

const page = {
  data: posts,
  currentPage: 1,
  lastPage: pageCount,
  url: {
    prev: undefined,
    next: pageCount > 1 ? '/berita/2' : undefined,
  },
};
---

<Layout
  title="Berita & Wawasan Energi Surya"
  description="Artikel dan panduan teknis energi surya dari Solar Nusantara: perhitungan sistem PLTS, efisiensi panel, komponen, dan perkembangan industri fotovoltaik."
>
  <section data-sonus-section class="bg-[#f2f7fb] border-b border-[#dbe5f0]">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[54px]">
      <h1 class="text-[32px] lg:text-[40px] font-bold leading-[1.15] text-[#14263d]">
        Berita &amp; Wawasan
      </h1>
      <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#5e7080] mt-[10px] max-w-[760px]">
        Ikuti perkembangan terbaru, proyek, dan inovasi dari Solar Nusantara.
      </p>
    </div>
  </section>

  <section data-sonus-section class="bg-white">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:py-[44px]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[20px] lg:gap-[24px]">
        {page.data.map((post, i) => <ArticleCard post={post} eager={i < 2} />)}
      </div>

      <nav
        class="mt-[36px] lg:mt-[48px] pt-[24px] border-t border-[#dbe5f0] flex flex-col sm:flex-row justify-between items-center gap-[16px]"
        aria-label="Navigasi halaman"
      >
        <div class="w-full sm:w-auto flex justify-start">
          {page.url.prev && (
            <a
              href={page.url.prev}
              class="inline-flex items-center justify-center h-[42px] px-[18px] rounded-[8px] border border-[#0f7dc7] text-[#0f7dc7] text-[14px] font-semibold hover:bg-[#0f7dc7] hover:text-white transition-colors"
            >
              ← Halaman Sebelumnya
            </a>
          )}
        </div>

        <div class="text-[14px] text-[#5e7080] font-medium">
          Halaman {page.currentPage} dari {page.lastPage}
        </div>

        <div class="w-full sm:w-auto flex justify-end">
          {page.url.next && (
            <a
              href={page.url.next}
              rel="next"
              class="inline-flex items-center justify-center h-[42px] px-[18px] rounded-[8px] bg-[#0f7dc7] text-white text-[14px] font-semibold hover:bg-[#0c6ab0] transition-colors w-full sm:w-auto"
            >
              Halaman Berikutnya →
            </a>
          )}
        </div>
      </nav>
    </div>
  </section>
</Layout>
