---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles, type Article } from '../../utils/articles';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPublishedArticles();
  return paginate(posts, { pageSize: 6 }).filter(
    (p) => p.props.page.currentPage !== 1,
  );
};

type Props = { page: Page<Article> };
const { page } = Astro.props;

const prevUrl = page.url.prev === '/berita/1' ? '/berita' : page.url.prev;
---

<Layout
  title={`Berita & Wawasan - Halaman ${page.currentPage}`}
  description={`Artikel dan panduan teknis energi surya dari Solar Nusantara, halaman ${page.currentPage} dari ${page.lastPage}: perhitungan PLTS, efisiensi panel, dan industri fotovoltaik.`}
>
  <section data-sonus-section class="bg-[#f2f7fb] border-b border-[#dbe5f0]">
    <div data-hero-enter class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[54px]">
      <h1 class="text-[32px] lg:text-[40px] font-bold leading-[1.15] text-[#14263d]">
        Berita &amp; Wawasan
      </h1>
      <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#5e7080] mt-[10px] max-w-[760px]">
        Ikuti perkembangan terbaru, proyek, dan inovasi dari Solar Nusantara.
      </p>
    </div>
  </section>

  <section data-sonus-section class="bg-white">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:py-[44px]">
      <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-2 gap-[20px] lg:gap-[24px]">
        {page.data.map((post, i) => <ArticleCard post={post} eager={i < 2} />)}
      </div>

      <nav
        class="mt-[36px] lg:mt-[48px] pt-[24px] border-t border-[#dbe5f0] flex flex-col sm:flex-row justify-between items-center gap-[16px]"
        aria-label="Navigasi halaman"
      >
        <div class="w-full sm:w-auto flex justify-start">
          {prevUrl && (
            <a
              href={prevUrl}
              rel="prev"
              class="inline-flex items-center justify-center h-[42px] px-[18px] rounded-[8px] border border-[#0f7dc7] text-[#0f7dc7] text-[14px] font-semibold hover:bg-[#0f7dc7] hover:text-white transition-colors w-full sm:w-auto"
            >
              ← Halaman Sebelumnya
            </a>
          )}
        </div>

        <div class="text-[14px] text-[#5e7080] font-medium">
          Halaman {page.currentPage} dari {page.lastPage}
        </div>

        <div class="w-full sm:w-auto flex justify-end">
          {page.url.next && (
            <a
              href={page.url.next}
              rel="next"
              class="inline-flex items-center justify-center h-[42px] px-[18px] rounded-[8px] bg-[#0f7dc7] text-white text-[14px] font-semibold hover:bg-[#0c6ab0] transition-colors w-full sm:w-auto"
            >
              Halaman Berikutnya →
            </a>
          )}
        </div>
      </nav>
    </div>
  </section>
</Layout>
