---
import Layout from '../../layouts/Layout.astro';

const internships = [
  'Engineering',
  'PMO',
  'Technical Support',
  'Product Fulfillment Monitoring Officer',
  'AI Prompt Engineer',
];

const permanentRoles = [
  'AI Prompt Engineer',
  'Business Partnership Officer',
  'Business Strategic Officer',
];
---

<Layout
  title="Karir"
  description="Peluang karir di Solar Nusantara, perusahaan EPC PLTS dan manajemen energi di Indonesia. Bergabunglah membangun transisi menuju Energi Baru Indonesia."
  ogImage="/images/og/karir.png"
>
  <!-- ===================================================================== -->
  <!-- PAGE INTRO                                                            -->
  <!-- ===================================================================== -->
  <section data-sonus-section class="bg-[#f4f7f9] border-b border-[#e2e9ee]">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:pt-[20px] lg:pb-[44px]">
      <nav aria-label="Breadcrumb" class="text-[12px] text-[#60717e] mb-[20px] lg:mb-[28px]">
        <a href="/" class="hover:text-[#1483c8] transition-colors">Beranda</a>
        <span class="mx-2">/</span>
        <a href="/tentang" class="hover:text-[#1483c8] transition-colors">Tentang Kami</a>
      </nav>

      <div class="flex flex-col gap-[10px]">
        <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
          TENTANG SONUS ID
        </p>
        <h1 class="text-[32px] lg:text-[42px] font-bold leading-[1.15] text-[#10283d]">
          Karir
        </h1>
        <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#60717e] max-w-[920px]">
          Bergabunglah dalam perjalanan energi bersih Indonesia. Kami mencari talenta yang siap berinovasi, berkolaborasi, dan memberikan dampak positif.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BERKARIER BERSAMA SONUS ID                                            -->
  <!-- ===================================================================== -->
  <section data-sonus-section class="bg-white">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[48px]">
      <div class="flex flex-col gap-[8px]">
        <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
          BERKARIER BERSAMA SONUS ID
        </p>
        <p class="text-[15px] font-normal leading-[1.55] text-[#60717e] max-w-[920px]">
          Bergabung dalam perjalanan energi bersih Indonesia. Kami mencari talenta yang siap berinovasi, berkolaborasi, dan memberikan dampak positif.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-[16px] lg:gap-[24px] mt-[22px] lg:mt-[28px]">
        <!-- Program Magang -->
        <article class="bg-white border border-[#e2e9ee] rounded-[12px] p-[23px] flex flex-col gap-[16px] lg:min-h-[256px]">
          <h2 class="text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
            PROGRAM MAGANG
          </h2>
          <ul class="flex flex-col gap-[12px] text-[16px] text-[#10283d]">
            {internships.map((role) => (
              <li class="flex items-center gap-[10px]">
                <span class="w-[6px] h-[6px] rounded-full bg-[#1483c8] shrink-0"></span>
                <span>{role}</span>
              </li>
            ))}
          </ul>
        </article>

        <!-- Staf Permanen -->
        <article class="bg-white border border-[#e2e9ee] rounded-[12px] p-[23px] flex flex-col gap-[16px] lg:min-h-[256px]">
          <h2 class="text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
            STAF PERMANEN
          </h2>
          <ul class="flex flex-col gap-[12px] text-[16px] text-[#10283d]">
            {permanentRoles.map((role) => (
              <li class="flex items-center gap-[10px]">
                <span class="w-[6px] h-[6px] rounded-full bg-[#1483c8] shrink-0"></span>
                <span>{role}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <!-- Careers CTA -->
      <div class="mt-[28px] lg:mt-[36px] bg-[#10283d] rounded-[12px] px-[22px] py-[24px] lg:px-[28px] lg:py-[28px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[18px]">
        <div class="flex flex-col gap-[6px]">
          <h2 class="text-[20px] lg:text-[22px] font-semibold leading-[1.25] text-white">
            Tertarik bergabung?
          </h2>
          <p class="text-[14px] font-normal text-white/90">
            Kirim CV melalui formulir rekrutmen atau hubungi kami via{' '}
            <a
              href="https://wa.me/6282170000575"
              target="_blank"
              rel="noopener noreferrer"
              class="underline text-[#66bff5] hover:text-white"
            >
              WhatsApp (+62 821-7000-0575)
            </a>.
          </p>
        </div>

        <a
          href="https://rekrutmen.solar-nusantara.id"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-[48px] px-[20px] rounded-[8px] bg-white text-[#1483c8] text-[14px] font-semibold transition-colors duration-200 hover:bg-[#f4f7f9] w-full lg:w-[200px] shrink-0 whitespace-nowrap"
        >
          Lamar Sekarang ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
