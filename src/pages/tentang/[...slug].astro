---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IntroPageMenu from '../../components/IntroPageMenu.astro';
import { navLinks, type NavLink } from '../../data/navLinks';

export async function getStaticPaths() {
  const entries = await getCollection('tentang');
  const parentLink = navLinks.find((link) => link.href === '/tentang');

  const paths = [];

  for (const entry of entries) {
    paths.push({
      params: { slug: entry.slug },
      props: { type: 'content', entry },
    });
  }

  function extractHubPaths(links: NavLink[]) {
    for (const link of links) {
      if (link.href?.startsWith('/tentang/') && link.children) {
        const slug = link.href.substring('/tentang/'.length);
        if (!paths.find((p) => p.params.slug === slug)) {
          paths.push({
            params: { slug },
            props: { type: 'hub', link },
          });
        }
      }
      if (link.children) extractHubPaths(link.children);
    }
  }

  if (parentLink?.children) {
    extractHubPaths(parentLink.children);
  }

  return paths;
}

const { slug } = Astro.params;
const { type, entry, link: hubLink } = Astro.props;

let title = '';
let description = '';
let menuItems: NavLink[] = [];
let Content = null;

if (type === 'content') {
  const rendered = await entry.render();
  Content = rendered.Content;
  title = entry.data.title;
  description = entry.data.description ?? '';

  const fullPath = `/tentang/${slug}`;
  const findInNav = (links: NavLink[]): NavLink | undefined => {
    for (const l of links) {
      if (l.href === fullPath) return l;
      if (l.children) {
        const found = findInNav(l.children);
        if (found) return found;
      }
    }
  };
  const navItem = findInNav(navLinks);
  menuItems = navItem?.children || [];
} else {
  title = hubLink?.text || 'Tentang';
  menuItems = hubLink?.children || [];
  const names = menuItems.map((i: NavLink) => i.text).slice(0, 4).join(', ');
  description = names
    ? `Informasi ${title} dari Solar Nusantara: ${names}. Perusahaan energi surya untuk kebutuhan residensial, komersial, dan industri di Indonesia.`
    : `${title} dari Solar Nusantara, perusahaan energi surya untuk kebutuhan residensial, komersial, dan industri di Indonesia.`;
}

const isPolicy = String(slug || '').includes('kebijakan');
const eyebrow = isPolicy ? 'KEBIJAKAN PERUSAHAAN' : 'TENTANG SONUS ID';
const breadcrumbs = isPolicy
  ? [
      { label: 'Beranda', href: '/' },
      { label: 'Tentang Kami', href: '/tentang' },
      { label: 'Kebijakan', href: '/tentang/kebijakan' },
      { label: title },
    ]
  : [
      { label: 'Beranda', href: '/' },
      { label: 'Tentang Kami', href: '/tentang' },
      { label: title },
    ];
---

<Layout title={title} description={description || undefined}>
  {Content ? (
    <>
      <!-- Page Intro -->
      <section data-sonus-section class="bg-[#f4f7f9] border-b border-[#e2e9ee]">
        <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:pt-[20px] lg:pb-[44px]">
          <nav aria-label="Breadcrumb" class="text-[12px] text-[#60717e] mb-[20px] lg:mb-[28px] flex flex-wrap items-center gap-[8px]">
            {breadcrumbs.map((crumb, idx) => (
              <>
                {idx > 0 && <span>/</span>}
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-[#1483c8] transition-colors">{crumb.label}</a>
                ) : (
                  <span class="text-[#10283d]">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>

          <div class="flex flex-col gap-[10px]">
            <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
              {eyebrow}
            </p>
            <h1 class="text-[30px] lg:text-[42px] font-bold leading-[1.15] text-[#10283d] max-w-[960px]">
              {title}
            </h1>
            {description && (
              <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#60717e] max-w-[840px]">
                {description}
              </p>
            )}
          </div>
        </div>
      </section>

      <!-- Document Body -->
      <section data-sonus-section class="bg-white">
        <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[52px]">
          <article class="prose lg:prose-lg max-w-[850px] prose-headings:text-[#10283d] prose-headings:font-bold prose-p:text-[#60717e] prose-li:text-[#60717e] prose-strong:text-[#10283d] prose-a:text-[#1483c8]">
            <Content />
          </article>

          {isPolicy && (
            <div class="mt-[40px] pt-[28px] border-t border-[#e2e9ee] max-w-[850px] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-[16px]">
              <a
                href="/tentang/kebijakan"
                class="inline-flex items-center gap-[8px] text-[14px] font-semibold text-[#1483c8] hover:underline"
              >
                <span>←</span>
                <span>Kembali ke Daftar Kebijakan</span>
              </a>
              <a
                href="/kontak"
                class="inline-flex items-center justify-center h-[44px] px-[20px] rounded-[8px] bg-[#1483c8] text-white text-[14px] font-semibold hover:bg-[#0f6ea8] transition-colors"
              >
                Hubungi Tim SONUS
              </a>
            </div>
          )}

          {menuItems.length > 0 && (
            <div class="mt-[48px] pt-[36px] border-t border-[#e2e9ee] max-w-[960px]">
              <p class="text-[11px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
                LANJUT MEMBACA
              </p>
              <h2 class="text-[22px] lg:text-[26px] font-bold text-[#10283d] mt-[6px] mb-[20px]">
                Halaman Terkait
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[16px]">
                {menuItems.map((item) => (
                  <a
                    href={item.href}
                    class="group bg-white border border-[#e2e9ee] rounded-[12px] p-[20px] flex items-center justify-between gap-[12px] transition-all duration-200 hover:border-[#1483c8] hover:shadow-[0_8px_24px_rgba(16,40,61,0.06)]"
                  >
                    <h3 class="text-[16px] font-semibold text-[#10283d] group-hover:text-[#1483c8] transition-colors">
                      {item.text}
                    </h3>
                    <span class="text-[#1483c8] shrink-0 transition-transform group-hover:translate-x-1">→</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    </>
  ) : (
    <IntroPageMenu
      title={title}
      items={menuItems}
      eyebrow="TENTANG SONUS ID"
      description={description}
      breadcrumbs={[
        { label: 'Beranda', href: '/' },
        { label: 'Tentang Kami', href: '/tentang' },
        { label: title },
      ]}
    />
  )}
</Layout>
