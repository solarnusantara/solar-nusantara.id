---
import Layout from '../layouts/Layout.astro';

const yogyakartaMapEmbed =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15812.309742187357!2d110.35352878006921!3d-7.781614501330258!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59001dea5167%3A0xd4e3b66a901e895!2sPT%20Tripower%20Solar%20Nusantara!5e0!3m2!1sen!2sid!4v1765249140562!5m2!1sen!2sid';

const googleMapsLink =
  'https://www.google.com/maps/search/?api=1&query=PT+Tripower+Solar+Nusantara+Pusat+Desain+Industri+Nasional+Yogyakarta';
---

<Layout
  title="Kontak"
  description="Hubungi Solar Nusantara untuk konsultasi proyek PLTS, manajemen energi, dan pengadaan komponen surya. Kantor pusat kami di PDIN Building, Yogyakarta."
>
  <!-- ===================================================================== -->
  <!-- INTRO BANNER                                                          -->
  <!-- ===================================================================== -->
  <section data-sonus-section class="bg-[#f2f7fb] border-b border-[#dbe5f0]">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[54px]">
      <h1 class="text-[32px] lg:text-[42px] font-bold leading-[1.15] text-[#14263d]">
        Hubungi Kami
      </h1>
      <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#5e7080] mt-[12px] max-w-[780px]">
        Kami siap membantu mewujudkan solusi energi Anda. Hubungi tim kami di Yogyakarta atau kirimkan email.
      </p>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- MAP + KANTOR YOGYAKARTA DETAILS                                       -->
  <!-- ===================================================================== -->
  <section data-sonus-section class="bg-white">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:py-[48px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-[20px] lg:gap-[30px] items-stretch">
        <!-- Map -->
        <div class="lg:col-span-7 rounded-[14px] overflow-hidden border border-[#dbe5f0] bg-[#e0f0e8] h-[250px] lg:h-[470px]">
          <iframe
            src={yogyakartaMapEmbed}
            title="Lokasi Kantor Pusat PT Tripower Solar Nusantara Yogyakarta"
            class="w-full h-full border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- Office Details Card -->
        <div class="lg:col-span-5 bg-white border border-[#dbe5f0] rounded-[14px] p-[22px] lg:p-[27px] flex flex-col justify-between gap-[20px]">
          <div class="flex flex-col gap-[20px]">
            <div>
              <p class="text-[11px] font-semibold tracking-[0.04em] text-[#0f7dc7] uppercase">
                KANTOR PUSAT
              </p>
              <h2 class="text-[22px] lg:text-[24px] font-bold leading-[1.25] text-[#14263d] mt-[8px]">
                Kantor Yogyakarta
              </h2>
              <address class="not-italic text-[15px] lg:text-[16px] leading-[1.55] text-[#5e7080] mt-[14px]">
                Pusat Desain Industri Nasional Lt. 2<br />
                Jl. C. Simanjuntak, Kec. Gondokusuman<br />
                Kota Yogyakarta, DIY 55223
              </address>
            </div>

            <div>
              <p class="text-[10px] font-semibold tracking-[0.04em] text-[#0f7dc7] uppercase">
                JAM KERJA
              </p>
              <p class="text-[14px] text-[#14263d] mt-[6px]">
                Senin–Jumat&nbsp;&nbsp;·&nbsp;&nbsp;08.00–17.00 WIB
              </p>
            </div>

            <div>
              <p class="text-[10px] font-semibold tracking-[0.04em] text-[#0f7dc7] uppercase">
                TELEPON / WHATSAPP
              </p>
              <a
                href="https://wa.me/6282170000575"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-[16px] font-semibold text-[#14263d] hover:text-[#0f7dc7] transition-colors mt-[6px]"
              >
                +62 821 7000 0575
              </a>
            </div>
          </div>

          <div class="pt-[8px]">
            <a
              href={googleMapsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-[6px] text-[14px] font-semibold text-[#0f7dc7] hover:underline"
            >
              <span>Buka di Google Maps</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- =================================================================== -->
      <!-- EMAIL CONTACT PANEL                                                 -->
      <!-- =================================================================== -->
      <div class="mt-[28px] lg:mt-[48px] bg-[#091a2e] rounded-[14px] px-[22px] py-[26px] lg:px-[44px] lg:py-[40px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[24px]">
        <div class="flex flex-col gap-[10px] max-w-[760px]">
          <p class="text-[11px] font-semibold tracking-[0.04em] text-[#66bff2] uppercase">
            ATAU KIRIM EMAIL
          </p>
          <h2 class="text-[24px] lg:text-[29px] font-bold leading-[1.2] text-white">
            Mari mulai percakapan.
          </h2>
          <p class="text-[14px] lg:text-[15px] leading-[1.55] text-[#d1deeb]">
            Ceritakan kebutuhan proyek Anda. Tim kami akan membantu mengarahkan langkah berikutnya.
          </p>
          <a
            href="mailto:busdev.sonus@solar-nusantara.id"
            class="inline-block text-[16px] lg:text-[18px] font-semibold text-white hover:text-[#66bff2] transition-colors mt-[10px] break-all"
          >
            busdev.sonus@solar-nusantara.id
          </a>
        </div>

        <a
          href="https://wa.me/6282170000575"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-[54px] px-[24px] rounded-[10px] bg-[#0f7dc7] text-white text-[13px] font-semibold transition-colors duration-200 hover:bg-[#0c6ab0] w-full lg:w-[236px] shrink-0 whitespace-nowrap"
        >
          Hubungi via WhatsApp&nbsp;&nbsp;→
        </a>
      </div>
    </div>
  </section>
</Layout>
