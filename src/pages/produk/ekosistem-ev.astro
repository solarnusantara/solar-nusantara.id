---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const spklEntry = await getEntry('produk', 'ekosistem-ev/spkl');
const rendered = spklEntry ? await spklEntry.render() : null;
const SpklContent = rendered?.Content;
---

<Layout
  title="Ekosistem EV & SPKL"
  description="Dukungan infrastruktur pengisian daya kendaraan listrik (SPKL) dari Solar Nusantara, terintegrasi dengan sistem panel surya dan baterai."
>
  <!-- Page Intro -->
  <section data-sonus-section class="bg-[#f4f7f9] border-b border-[#e2e9ee]">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:pt-[20px] lg:pb-[44px]">
      <nav aria-label="Breadcrumb" class="text-[12px] text-[#60717e] mb-[20px] lg:mb-[28px] flex flex-wrap items-center gap-[8px]">
        <a href="/" class="hover:text-[#1483c8] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[#1483c8] transition-colors">Solusi</a>
        <span>/</span>
        <a href="/produk" class="hover:text-[#1483c8] transition-colors">Produk</a>
        <span>/</span>
        <span class="text-[#10283d]">Ekosistem EV</span>
      </nav>

      <div class="flex flex-col gap-[10px]">
        <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
          PRODUK &amp; TEKNOLOGI
        </p>
        <h1 class="text-[32px] lg:text-[42px] font-bold leading-[1.15] text-[#10283d]">
          Ekosistem EV &amp; SPKL
        </h1>
        <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#60717e] max-w-[820px]">
          Dukungan infrastruktur pengisian daya kendaraan listrik (SPKL) yang terintegrasi dengan sistem panel surya dan penyimpanan baterai dari SONUS ID.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Body -->
  <section data-sonus-section class="bg-white">
    <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[52px]">
      <div class="bg-white border border-[#e0e8ee] rounded-[14px] p-[22px] lg:p-[32px]">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-[10px] pb-[18px] mb-[22px] border-b border-[#e2e9ee]">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
              INFRASTRUKTUR PENGISIAN DAYA
            </p>
            <h2 class="text-[24px] lg:text-[28px] font-bold text-[#10283d] mt-[4px]">
              SPKL | Pengisian Daya Kendaraan Listrik
            </h2>
          </div>
          <a
            href="/produk/ekosistem-ev/spkl"
            class="text-[13px] font-semibold text-[#1483c8] hover:underline shrink-0"
          >
            Tautan langsung →
          </a>
        </div>

        {SpklContent && (
          <article class="prose lg:prose-lg max-w-[850px] prose-headings:text-[#10283d] prose-p:text-[#60717e] prose-li:text-[#60717e] prose-strong:text-[#10283d] prose-a:text-[#1483c8]">
            <SpklContent />
          </article>
        )}
      </div>

      <!-- Contact CTA -->
      <div class="mt-[36px] bg-[#1483c8] rounded-[14px] px-[22px] py-[26px] lg:px-[32px] lg:py-[32px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[20px]">
        <div class="flex flex-col gap-[6px] max-w-[720px]">
          <p class="text-[11px] font-semibold tracking-[0.04em] text-[#cfe0f5] uppercase">
            KONSULTASI EKOSISTEM EV
          </p>
          <h2 class="text-[22px] lg:text-[26px] font-bold leading-[1.2] text-white">
            Menyiapkan infrastruktur pengisian EV berbasis energi surya?
          </h2>
          <p class="text-[14px] text-[#e1ecf8]">
            Diskusikan kebutuhan SPKL, panel surya, dan sistem baterai bersama tim SONUS ID.
          </p>
        </div>
        <a
          href="/kontak"
          class="inline-flex items-center justify-center h-[45px] px-[20px] rounded-[8px] bg-white text-[#1483c8] text-[14px] font-semibold hover:bg-[#f4f7f9] transition-colors w-full lg:w-auto shrink-0 whitespace-nowrap"
        >
          Hubungi Tim SONUS →
        </a>
      </div>
    </div>
  </section>
</Layout>
