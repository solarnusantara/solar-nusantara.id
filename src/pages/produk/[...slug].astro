---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IntroPageMenu from '../../components/IntroPageMenu.astro';
import { navLinks, type NavLink } from '../../data/navLinks';
import { buildProductSchema } from '../../utils/productSchema';
import { buildFaqSchema } from '../../utils/faqSchema';
import FaqSection from '../../components/FaqSection.astro';
import PageToc, { type TocHeading } from '../../components/PageToc.astro';

export async function getStaticPaths() {
  const entries = await getCollection('produk');
  const parentLink = navLinks.find((link) => link.href === '/produk');

  const paths = [];

  for (const entry of entries) {
    paths.push({
      params: { slug: entry.slug },
      props: { type: 'content', entry },
    });
  }

  function extractHubPaths(links: NavLink[]) {
    for (const link of links) {
      if (link.href?.startsWith('/produk/') && link.children) {
        const slug = link.href.substring('/produk/'.length);
        // Dedicated static pages handle energi-biomassa and ekosistem-ev
        if (slug === 'energi-biomassa' || slug === 'ekosistem-ev') continue;
        if (!paths.find((p) => p.params.slug === slug)) {
          paths.push({
            params: { slug },
            props: { type: 'hub', link },
          });
        }
      }
      if (link.children) extractHubPaths(link.children);
    }
  }

  if (parentLink?.children) {
    extractHubPaths(parentLink.children);
  }

  return paths;
}

const { slug } = Astro.params;
const { type, entry, link: hubLink } = Astro.props;

let title = '';
let description = '';
let menuItems: NavLink[] = [];
let Content = null;
let headings: TocHeading[] = [];
let jsonLd: Record<string, unknown>[] = [];
let faq = [];

if (type === 'content') {
  const rendered = await entry.render();
  Content = rendered.Content;
  headings = rendered.headings ?? [];
  title = entry.data.title;
  description = entry.data.description ?? '';

  const baseUrl = Astro.site ? Astro.site.origin : Astro.url.origin;
  jsonLd = buildProductSchema({
    url: new URL(Astro.url.pathname, baseUrl).href,
    baseUrl,
    name: title,
    description,
    properties: entry.data.properties,
  });
  faq = entry.data.faq ?? [];
  jsonLd = [...jsonLd, ...buildFaqSchema(new URL(Astro.url.pathname, baseUrl).href, faq)];

  const fullPath = `/produk/${slug}`;
  const findInNav = (links: NavLink[]): NavLink | undefined => {
    for (const l of links) {
      if (l.href === fullPath) return l;
      if (l.children) {
        const found = findInNav(l.children);
        if (found) return found;
      }
    }
  };
  const navItem = findInNav(navLinks);
  menuItems = navItem?.children || [];
} else {
  title = hubLink.text;
  menuItems = hubLink.children || [];
  const SUFFIX = 'Solusi energi surya untuk residensial, komersial, dan industri.';
  const names = menuItems.map((i: NavLink) => i.text).slice(0, 4);
  const build = (list: string[]) => `Daftar ${title} dari Solar Nusantara: ${list.join(', ')}. ${SUFFIX}`;
  while (names.length > 1 && build(names).length > 160) names.pop();
  description = names.length
    ? build(names)
    : `${title} dari Solar Nusantara, penyedia solusi energi surya untuk kebutuhan residensial, komersial, dan industri di Indonesia.`;
}

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Solusi', href: '/layanan' },
  { label: 'Produk', href: '/produk' },
  { label: title },
];

const tocHeadings: TocHeading[] = [
  ...headings,
  ...(menuItems.length > 0 ? [{ depth: 2, slug: 'sub-produk', text: `Kategori ${title}` }] : []),
  ...(faq.length > 0 ? [{ depth: 2, slug: 'faq-heading', text: 'Pertanyaan yang Sering Diajukan' }] : []),
];
---

<Layout title={title} description={description || undefined} jsonLd={jsonLd}>
  {Content ? (
    <>
      <!-- Page Intro -->
      <section data-sonus-section class="bg-[#f4f7f9] border-b border-[#e2e9ee]">
        <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:pt-[20px] lg:pb-[44px]">
          <nav aria-label="Breadcrumb" class="text-[12px] text-[#60717e] mb-[20px] lg:mb-[28px] flex flex-wrap items-center gap-[8px]">
            {breadcrumbs.map((crumb, idx) => (
              <>
                {idx > 0 && <span>/</span>}
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-[#1483c8] transition-colors">{crumb.label}</a>
                ) : (
                  <span class="text-[#10283d]">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>

          <div class="flex flex-col gap-[10px]">
            <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
              PRODUK &amp; TEKNOLOGI
            </p>
            <h1 class="text-[30px] lg:text-[42px] font-bold leading-[1.15] text-[#10283d] max-w-[960px]">
              {title}
            </h1>
            {description && (
              <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#60717e] max-w-[840px]">
                {description}
              </p>
            )}
          </div>
        </div>
      </section>

      <!-- Product Body + Sticky TOC -->
      <section data-sonus-section class="bg-white">
        <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[52px]">
          <div class="flex flex-col lg:flex-row gap-[28px] lg:gap-[48px] items-start">
            <div class="flex-1 w-full min-w-0 lg:max-w-[850px]">
              <article class="prose lg:prose-lg max-w-none prose-headings:text-[#10283d] prose-headings:font-bold prose-p:text-[#60717e] prose-li:text-[#60717e] prose-strong:text-[#10283d] prose-a:text-[#1483c8]">
                <Content />
              </article>

              {menuItems.length > 0 && (
                <div id="sub-produk" class="mt-[48px] pt-[36px] border-t border-[#e2e9ee] scroll-mt-[120px]">
                  <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
                    SUB-PRODUK
                  </p>
                  <h2 class="text-[22px] lg:text-[26px] font-bold text-[#10283d] mt-[6px] mb-[20px]">
                    Kategori {title}
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-[16px]">
                    {menuItems.map((item, idx) => (
                      <a
                        href={item.href}
                        class="group bg-white border border-[#e0e8ee] rounded-[12px] p-[20px] flex flex-col justify-between gap-[12px] transition-all duration-200 hover:border-[#1483c8] hover:shadow-[0_8px_24px_rgba(16,40,61,0.06)]"
                      >
                        <p class="text-[11px] font-semibold text-[#1483c8]">{String(idx + 1).padStart(2, '0')}</p>
                        <div class="flex items-center justify-between gap-[10px]">
                          <h3 class="text-[17px] font-bold text-[#10283d] group-hover:text-[#1483c8] transition-colors">
                            {item.text}
                          </h3>
                          <span class="text-[#1483c8] shrink-0 transition-transform group-hover:translate-x-1">→</span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <FaqSection items={faq} />
            </div>

            <PageToc
              headings={tocHeadings}
              ctaTitle={`Butuh spesifikasi ${title}?`}
              ctaHref="https://sonushub.id"
              ctaLabel="Cek di SonusHUB ↗"
            />
          </div>

          <!-- SonusHUB / Contact CTA -->
          <div class="mt-[48px] bg-[#1483c8] rounded-[14px] px-[22px] py-[26px] lg:px-[32px] lg:py-[32px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[20px]">
            <div class="flex flex-col gap-[6px] max-w-[720px]">
              <p class="text-[11px] font-semibold tracking-[0.04em] text-[#cfe0f5] uppercase">
                PENGADAAN MATERIAL
              </p>
              <h2 class="text-[22px] lg:text-[26px] font-bold leading-[1.2] text-white">
                Butuh penawaran atau spesifikasi {title}?
              </h2>
              <p class="text-[14px] text-[#e1ecf8]">
                Cek katalog material di SonusHUB atau konsultasikan kebutuhan proyek dengan tim kami.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-[12px] shrink-0">
              <a
                href="https://sonushub.id"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center h-[45px] px-[20px] rounded-[8px] bg-white text-[#1483c8] text-[14px] font-semibold hover:bg-[#f4f7f9] transition-colors whitespace-nowrap"
              >
                Kunjungi SonusHUB ↗
              </a>
              <a
                href="/kontak"
                class="inline-flex items-center justify-center h-[45px] px-[20px] rounded-[8px] border border-white text-white text-[14px] font-semibold hover:bg-white/10 transition-colors whitespace-nowrap"
              >
                Hubungi Kami
              </a>
            </div>
          </div>
        </div>
      </section>
    </>
  ) : (
    <IntroPageMenu
      title={title}
      items={menuItems}
      eyebrow="PRODUK & TEKNOLOGI"
      description={description}
      breadcrumbs={breadcrumbs}
    />
  )}
</Layout>
