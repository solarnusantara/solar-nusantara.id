---
import { Image } from 'astro:assets';
import footerLogo from '../assets/redesign/logo-footer.svg';
import isoBadge from '../assets/redesign/iso-badge.png';
import iconInstagram from '../assets/redesign/icon-instagram.svg';
import iconYoutube from '../assets/redesign/icon-youtube.svg';
import iconLinkedin from '../assets/redesign/icon-linkedin.svg';

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://instagram.com/solar_nusantara',
    icon: iconInstagram,
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@Sonus.ID_',
    icon: iconYoutube,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/solar-nusantara/',
    icon: iconLinkedin,
  },
];
---

<footer class="bg-[#061529] text-white font-sans">
  <div class="max-w-[1440px] mx-auto px-[20px] py-[24px] lg:px-[80px] lg:pt-[42px] lg:pb-[28px]">
    <!-- Desktop Footer Layout -->
    <div class="hidden lg:flex items-start justify-between gap-[36px]">
      <!-- Brand + ISO + Social Icons -->
      <div class="flex items-start gap-[48px] flex-1 min-w-0">
        <div class="flex flex-col gap-[7px]">
          <a href="/" aria-label="Solar Nusantara Beranda">
            <img
              src={footerLogo.src}
              alt="Solar Nusantara Logo"
              width={190}
              height={39}
              class="h-[39px] w-[190px] object-contain"
            />
          </a>
          <p class="text-[12px] text-[#c6d4e4]">Solar Nusantara</p>
        </div>

        <div class="flex flex-col gap-[10px] shrink-0">
          <Image
            src={isoBadge}
            alt="Sertifikasi ISO 9001:2015 dan ISO 45001:2018 Solar Nusantara"
            width={140}
            height={70}
            class="h-[70px] w-[140px] object-contain"
          />
          <div class="flex items-center gap-[16px]" aria-label="Media sosial Solar Nusantara">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.name} Solar Nusantara`}
                class="inline-flex items-center justify-center w-[24px] h-[24px] transition-opacity duration-150 hover:opacity-80"
              >
                <img
                  src={social.icon.src}
                  alt={`Ikon ${social.name} Solar Nusantara`}
                  width={24}
                  height={24}
                  class="w-[24px] h-[24px]"
                />
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- PERUSAHAAN -->
      <div class="flex flex-col gap-[8px] shrink-0 min-w-[110px]">
        <p class="text-[11px] font-bold tracking-[0.04em] text-white uppercase">PERUSAHAAN</p>
        <a href="/tentang" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">Tentang Kami</a>
        <a href="/portofolio" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">Portofolio</a>
        <a href="/kontak" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">Kontak</a>
      </div>

      <!-- BISNIS -->
      <div class="flex flex-col gap-[8px] shrink-0 min-w-[160px]">
        <p class="text-[11px] font-bold tracking-[0.04em] text-white uppercase">BISNIS</p>
        <a href="/layanan" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">Developer</a>
        <a href="/layanan/sistem-tenaga-surya-epc" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">EPC PLTS</a>
        <a href="https://sonushub.id" target="_blank" rel="noopener noreferrer" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">SonusHUB</a>
        <a href="/layanan/manajemen-energi" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">O&amp;M / Project Management</a>
      </div>

      <!-- HUBUNGI KAMI -->
      <div class="flex flex-col gap-[8px] shrink-0 w-[260px]">
        <p class="text-[11px] font-bold tracking-[0.04em] text-white uppercase">HUBUNGI KAMI</p>
        <a href="tel:+6282180000575" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">+62 821-8000-0575</a>
        <a href="mailto:sonus@solar-nusantara.id" class="text-[12px] text-[#c6d4e4] hover:text-white transition-colors">sonus@solar-nusantara.id</a>
        <p class="text-[12px] text-[#c6d4e4]">PDIN Building, Yogyakarta</p>
      </div>
    </div>

    <!-- Desktop Legal Bar -->
    <div class="hidden lg:flex items-center justify-between border-t border-[#263b52] mt-[28px] pt-[16px] text-[10px] text-[#8fa4bc]">
      <p>© 2027 Solar Nusantara</p>
      <p>solar-nusantara.id&nbsp;&nbsp;•&nbsp;&nbsp;sonushub.id</p>
    </div>

    <!-- Mobile Footer Layout (Matches Figma: Mobile Footer · 390px) -->
    <div class="flex lg:hidden items-start justify-between gap-[16px]">
      <div class="flex flex-col gap-[10px] min-w-0">
        <a href="/" aria-label="Solar Nusantara Beranda">
          <img
            src={footerLogo.src}
            alt="Solar Nusantara Logo"
            width={160}
            height={32}
            class="h-[32px] w-auto object-contain"
          />
        </a>
        <p class="text-[12px] text-[#d5e2f0]">Solar Nusantara</p>
        <a href="tel:+6282180000575" class="text-[12px] text-[#d5e2f0]">+62 821-8000-0575</a>
        <a href="mailto:sonus@solar-nusantara.id" class="text-[12px] text-[#d5e2f0] break-all">sonus@solar-nusantara.id</a>
        <p class="text-[12px] text-[#d5e2f0]">PDIN Building, Yogyakarta</p>
        <p class="text-[11px] text-[#afc7d5] pt-[2px]">solar-nusantara.id&nbsp;&nbsp;•&nbsp;&nbsp;sonushub.id</p>
      </div>

      <div class="flex flex-col items-start gap-[10px] shrink-0">
        <Image
          src={isoBadge}
          alt="Sertifikasi ISO 9001:2015 dan ISO 45001:2018 Solar Nusantara"
          width={118}
          height={59}
          class="h-[59px] w-[118px] object-contain"
        />
        <div class="flex items-center gap-[16px]" aria-label="Media sosial Solar Nusantara">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.name} Solar Nusantara`}
              class="inline-flex items-center justify-center w-[24px] h-[24px] transition-opacity duration-150 hover:opacity-80"
            >
              <img
                src={social.icon.src}
                alt={`Ikon ${social.name} Solar Nusantara`}
                width={24}
                height={24}
                class="w-[24px] h-[24px]"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
