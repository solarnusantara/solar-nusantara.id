---
import { Image } from 'astro:assets';
import RelatedArticles from './RelatedArticles.astro';
import { countWords, type Article } from '../utils/articles';
import { resolveAuthor } from '../data/authors';

type Props = { data: Article['data']; body: string; related: Article[] };

const { data, body, related } = Astro.props;

const dayKey = (d: Date) => d.toISOString().slice(0, 10);
const showUpdated = !!data.updatedDate && dayKey(data.updatedDate) > dayKey(data.pubDate);

const wordsPerMinute = 200;
const readingTime = Math.ceil(countWords(body) / wordsPerMinute);

const byline = resolveAuthor(data);
const external = byline.url ? !byline.url.startsWith('/') : false;
const fmt = (d: Date) => d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

{/* Reading progress, scrubbed by src/scripts/motion.ts. Starts at scaleX(0) so it stays invisible without JS. */}
<div
  data-read-progress
  aria-hidden="true"
  class="not-prose fixed top-0 left-0 right-0 h-[3px] bg-[#1483c8] origin-left z-[55] pointer-events-none"
  style="transform: scaleX(0)"
></div>

<div class="not-prose text-[14px] text-[#5e7080] mb-[24px] flex flex-wrap items-center gap-x-[10px] gap-y-[4px]">
  <time datetime={data.pubDate.toISOString()} class="whitespace-nowrap">
    {fmt(data.pubDate)}
  </time>
  <span class="whitespace-nowrap">
    <span class="mr-[10px] text-[#9bb0c4]">·</span>
    <span>Oleh </span>
    {byline.url ? (
      <a
        href={byline.url}
        rel={external ? 'author noopener noreferrer' : 'author'}
        target={external ? '_blank' : undefined}
        class="font-medium text-[#14263d] hover:text-[#0f7dc7] hover:underline transition-colors"
      >{byline.name}</a>
    ) : (
      <span class="font-medium text-[#14263d]">{byline.name}</span>
    )}
  </span>
  {showUpdated && data.updatedDate && (
    <span class="whitespace-nowrap">
      <span class="mr-[10px] text-[#9bb0c4]">·</span>
      <span>Diperbarui </span><time datetime={data.updatedDate.toISOString()}>{fmt(data.updatedDate)}</time>
    </span>
  )}
  <span class="whitespace-nowrap">
    <span class="mr-[10px] text-[#9bb0c4]">·</span>
    <span>{readingTime} menit baca</span>
  </span>
</div>

{data.heroImage && (
  <div class="mb-[32px] not-prose rounded-[12px] overflow-hidden border border-[#dbe5f0] bg-[#d9edf7]">
    <Image
      src={data.heroImage}
      alt={data.heroImageAlt || data.title}
      width={1200}
      height={600}
      class="w-full h-auto object-cover"
      loading="eager"
    />
  </div>
)}

<slot />

{byline.registry && (
  <aside
    class="not-prose mt-[48px] rounded-[12px] bg-[#f2f7fb] border border-[#dbe5f0] px-[22px] py-[20px]"
    aria-label="Tentang penulis"
  >
    <p class="text-[10px] font-semibold uppercase tracking-[0.05em] text-[#0f7dc7]">
      PENULIS
    </p>
    <p class="mt-[6px] text-[18px] font-semibold text-[#14263d]">
      <a href={byline.url} rel="author" class="hover:text-[#0f7dc7] transition-colors">
        {byline.registry.name}
      </a>
      {byline.registry.jobTitle && (
        <span class="ml-2 text-[13px] font-medium text-[#0f7dc7]">{byline.registry.jobTitle}</span>
      )}
    </p>
    <p class="mt-[6px] text-[13px] leading-[1.55] text-[#5e7080]">{byline.registry.bio}</p>
  </aside>
)}

<RelatedArticles posts={related} />
