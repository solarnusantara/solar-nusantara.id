---
import { Image } from 'astro:assets';
import RelatedArticles from './RelatedArticles.astro';
import { countWords, type Article } from '../utils/articles';
import { resolveAuthor } from '../data/authors';

/**
 * Everything an article shows inside the Layout: the date line, the hero, the
 * body (the default slot) and the related links. Shared by the live article and
 * its preview, so a preview looks exactly like the page it will become.
 */
type Props = { data: Article['data']; body: string; related: Article[] };

const { data, body, related } = Astro.props;

// Calculate reading time
const wordsPerMinute = 200;
const readingTime = Math.ceil(countWords(body) / wordsPerMinute);

const byline = resolveAuthor(data);
const external = byline.url ? !byline.url.startsWith('/') : false;
const fmt = (d: Date) => d.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
// Shown only for a real revision: dateModified in the schema and the sitemap
// lastmod come from the same updatedDate, so reader and crawler see one date.
const revised = data.updatedDate && fmt(data.updatedDate) !== fmt(data.pubDate) ? data.updatedDate : null;
---

<div class="text-lg text-gray-500 -mt-8 mb-8 flex flex-wrap items-center gap-x-2">
  <time datetime={data.pubDate.toISOString()} class="whitespace-nowrap">
    {data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
  </time>
  <span class="whitespace-nowrap">
    <span class="text-gray-400">&bull;</span>
    <span>Oleh </span>
    {byline.url ? (
      <a
        href={byline.url}
        rel={external ? 'author noopener noreferrer' : 'author'}
        target={external ? '_blank' : undefined}
        class="text-gray-800 hover:text-blue-600 hover:underline transition-colors"
      >{byline.name}</a>
    ) : (
      <span>{byline.name}</span>
    )}
  </span>
  {revised && (
    <span class="whitespace-nowrap">
      <span class="text-gray-400">&bull;</span>
      <span>Diperbarui </span><time datetime={revised.toISOString()}>{fmt(revised)}</time>
    </span>
  )}
  <span class="whitespace-nowrap">
    <span class="text-gray-400">&bull;</span>
    <span>{readingTime} menit baca</span>
  </span>
</div>

{data.heroImage && (
  <div class="mb-12 not-prose -mx-4 sm:-mx-8 md:-mx-16 lg:mx-0">
    <Image 
      src={data.heroImage} 
      alt={data.heroImageAlt || data.title} 
      width={1200} 
      height={600} 
      class="w-full h-auto object-cover rounded-2xl shadow-lg" 
      loading="eager" 
    />
  </div>
)}

<slot />

{byline.registry && (
  <aside class="not-prose mt-16 rounded-2xl border border-gray-200 bg-gray-50 p-6" aria-label="Tentang penulis">
    <p class="text-sm uppercase tracking-wide text-gray-500">Penulis</p>
    <p class="mt-1 text-xl font-bold text-gray-900">
      <a href={byline.url} rel="author" class="hover:text-blue-600">{byline.registry.name}</a>
      <span class="ml-2 text-base font-medium text-blue-600">{byline.registry.jobTitle}</span>
    </p>
    <p class="mt-2 text-gray-700">{byline.registry.bio}</p>
  </aside>
)}

<RelatedArticles posts={related} />
