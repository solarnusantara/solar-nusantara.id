---
import type { NavLink } from '../data/navLinks';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  items: NavLink[] | undefined;
  eyebrow?: string;
  description?: string;
  breadcrumbs?: Crumb[];
}

const {
  title,
  items = [],
  eyebrow = 'SOLAR NUSANTARA',
  description = 'Jelajahi rangkaian solusi dan komponen energi terbarukan dari SONUS ID.',
  breadcrumbs = [{ label: 'Beranda', href: '/' }, { label: title }],
} = Astro.props;
---

<!-- Page Intro -->
<section data-sonus-section class="bg-[#f4f7f9] border-b border-[#e2e9ee]">
  <div class="max-w-[1440px] mx-auto px-[20px] py-[28px] lg:px-[80px] lg:pt-[20px] lg:pb-[44px]">
    <nav aria-label="Breadcrumb" class="text-[12px] text-[#60717e] mb-[20px] lg:mb-[28px] flex flex-wrap items-center gap-[8px]">
      {breadcrumbs.map((crumb, idx) => (
        <>
          {idx > 0 && <span>/</span>}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-[#1483c8] transition-colors">{crumb.label}</a>
          ) : (
            <span class="text-[#10283d]">{crumb.label}</span>
          )}
        </>
      ))}
    </nav>

    <div class="flex flex-col gap-[10px]">
      <p class="text-[11px] lg:text-[12px] font-semibold tracking-[0.04em] text-[#1483c8] uppercase">
        {eyebrow}
      </p>
      <h1 class="text-[32px] lg:text-[42px] font-bold leading-[1.15] text-[#10283d]">
        {title}
      </h1>
      <p class="text-[16px] lg:text-[18px] font-normal leading-[1.5] text-[#60717e] max-w-[820px]">
        {description}
      </p>
    </div>
  </div>
</section>

<!-- Cards Grid -->
<section data-sonus-section class="bg-white">
  <div class="max-w-[1440px] mx-auto px-[20px] py-[32px] lg:px-[80px] lg:py-[52px]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[16px] lg:gap-[24px]">
      {items.map((item, idx) => (
        <div class="bg-white border border-[#e0e8ee] rounded-[14px] p-[22px] lg:p-[24px] flex flex-col justify-between gap-[16px] transition-all duration-200 hover:border-[#1483c8] hover:shadow-[0_8px_24px_rgba(16,40,61,0.06)]">
          <div class="flex flex-col gap-[10px]">
            <p class="text-[11px] font-semibold tracking-[0.04em] text-[#1483c8]">
              {String(idx + 1).padStart(2, '0')}
            </p>
            <a href={item.href || '#'} class="group inline-flex items-center justify-between gap-2">
              <h2 class="text-[20px] lg:text-[21px] font-bold leading-[1.25] text-[#10283d] group-hover:text-[#1483c8] transition-colors">
                {item.text}
              </h2>
              {item.href && (
                <span class="text-[#1483c8] text-[16px] transition-transform duration-200 group-hover:translate-x-1 shrink-0">→</span>
              )}
            </a>

            {item.children && item.children.length > 0 && (
              <ul class="mt-[4px] flex flex-col gap-[8px] pt-[12px] border-t border-[#f0f4f8]">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href || '#'}
                      class="inline-flex items-center gap-[8px] text-[14px] text-[#60717e] hover:text-[#1483c8] transition-colors"
                    >
                      <span class="w-[5px] h-[5px] rounded-full bg-[#1483c8] shrink-0"></span>
                      <span>{child.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {item.href && (
            <div class="pt-[4px]">
              <a
                href={item.href}
                class="inline-flex items-center gap-[6px] text-[13px] font-semibold text-[#1483c8] hover:underline"
              >
                <span>Lihat detail</span>
                <span>→</span>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom Contact CTA -->
    <div class="mt-[36px] lg:mt-[52px] bg-[#f4f8fa] border border-[#e2e9ee] rounded-[14px] px-[22px] py-[26px] lg:px-[32px] lg:py-[32px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[20px]">
      <div class="flex flex-col gap-[6px] max-w-[760px]">
        <h2 class="text-[22px] lg:text-[26px] font-bold leading-[1.2] text-[#10283d]">
          Butuh rekomendasi untuk proyek Anda?
        </h2>
        <p class="text-[15px] text-[#60717e]">
          Diskusikan spesifikasi teknis atau pengadaan material bersama tim SONUS ID.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-[12px] shrink-0">
        <a
          href="/kontak"
          class="inline-flex items-center justify-center h-[45px] px-[20px] rounded-[8px] bg-[#1483c8] text-white text-[14px] font-semibold hover:bg-[#0f6ea8] transition-colors whitespace-nowrap"
        >
          Konsultasikan Proyek
        </a>
        <a
          href="https://sonushub.id"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-[45px] px-[20px] rounded-[8px] bg-white border border-[#1483c8] text-[#1483c8] text-[14px] font-semibold hover:bg-[#f4f7f9] transition-colors whitespace-nowrap"
        >
          Kunjungi SonusHUB ↗
        </a>
      </div>
    </div>
  </div>
</section>
