---
import type { FaqItem } from '../utils/faqSchema';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="mt-16 pt-8 border-t" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl font-bold mb-6">Pertanyaan yang Sering Diajukan</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="group border rounded-lg p-4 hover:border-blue-600 transition-all">
          <summary class="cursor-pointer font-semibold text-blue-600 list-none flex justify-between items-start gap-4">
            <span>{item.q}</span>
            <span class="shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 mb-0">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
