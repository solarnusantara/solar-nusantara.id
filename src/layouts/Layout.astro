---
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';
import MobileHeader from '../components/MobileHeader.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE_CONFIG } from '../config';

interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings?: Heading[];
  frontmatter?: {
    title: string;
    /**
     * Short title for <title> and og:title only. The <h1> always uses `title`.
     * Google truncates the SERP title around 60 characters, but an on-page
     * heading should stay descriptive - so they are two fields, not one
     * compromise string. 7 of the 18 existing articles have a title past 60.
     */
    seoTitle?: string;
    description?: string;
    heroImage?: any;
    pubDate?: Date;
    updatedDate?: Date;
  };
  title?: string;
  /**
   * Meta description for .astro pages, which have no frontmatter to read one
   * from. Without it the page falls back to the site-wide description - and 50
   * of the 70 built pages were doing exactly that, sharing one identical
   * <meta name="description"> between them.
   */
  description?: string;
  ogImage?: string; // New prop for Astro pages
  /**
   * Load the KaTeX stylesheet for this page. Off by default.
   *
   * It used to be unconditional: a render-blocking cross-origin stylesheet on
   * all 66 pages, when exactly 3 of them contain any math. The article route
   * sets this by scanning the body for math delimiters, so no author has to
   * remember it.
   */
  needsKatex?: boolean;
  /**
   * Extra schema.org nodes to merge into this page's single @graph.
   *
   * Pages MUST pass their page-level schema here rather than rendering a second
   * <script type="application/ld+json"> of their own. Two competing graphs on
   * one page give Google two descriptions of the same thing; one graph whose
   * nodes reference each other by @id gives it one. Article nodes should point
   * at `${baseUrl}/#organization` and `${baseUrl}/#website` instead of
   * redefining the publisher inline.
   */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results: the public draft previews under /pratinjau/. */
  noindex?: boolean;
}

const { headings, frontmatter, title: directTitle, description: directDescription, ogImage, jsonLd = [], needsKatex = false, noindex = false } = Astro.props;

// Canonical origin + path only, deliberately dropping any querystring or hash.
// Derived from `site` in astro.config.mjs (exposed as import.meta.env.SITE) so
// it cannot drift from the configured domain. Used for <link rel="canonical">,
// og:url and twitter:url alike - those three must agree.
const canonicalUrl = new URL(
	Astro.url.pathname,
	import.meta.env.SITE ?? SITE_CONFIG.url,
).href;

// This is the key change: Detect if the page is from Markdown based on `frontmatter`
const isMarkdownPage = !!frontmatter;

// Determine title and description based on page type
// `title` is the on-page <h1>. `pageTitle` is what search engines and social
// cards show. They are deliberately allowed to differ.
const title = isMarkdownPage ? frontmatter.title : directTitle || SITE_CONFIG.title;

const BRAND = SITE_CONFIG.title;
const SERP_TITLE_MAX = 60;
const BRAND_SUFFIX = ` | ${BRAND}`;
const rawPageTitle = (isMarkdownPage ? frontmatter.seoTitle || frontmatter.title : directTitle) || BRAND;
// The brand suffix is appended only when it fits.
//
// Two reasons to skip it: the title already names the brand (so the homepage
// does not render "Solar Nusantara | Solar Nusantara"), or appending it would
// push the title past what Google shows. A suffix that gets truncated costs
// characters of real title and buys nothing, so the page keeps the bare title.
const pageTitle =
	rawPageTitle.includes(BRAND) ||
	rawPageTitle.length + BRAND_SUFFIX.length > SERP_TITLE_MAX
		? rawPageTitle
		: rawPageTitle + BRAND_SUFFIX;

const description = frontmatter?.description || directDescription || SITE_CONFIG.description;

// Determine Open Graph image.
// Resolved against the canonical URL, not Astro.url: Astro.url carries the
// querystring, and a relative image source would otherwise resolve against the
// current path rather than the site root.
const imageSrc = ogImage || frontmatter?.heroImage?.src || '/meta.png';
const ogImageUrl = new URL(imageSrc, canonicalUrl).href;

const hasHeadings = headings && headings.length > 0;

const baseUrl = Astro.site ? Astro.site.origin : SITE_CONFIG.url;
const logoUrl = new URL('/favicon.svg', baseUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${baseUrl}/#organization`,
      "name": "PT Tripower Solar Nusantara",
      "alternateName": ["Solar Nusantara", "SONUS", "Sonus EPC"],
      "url": baseUrl,
      "logo": {
        "@type": "ImageObject",
        "url": logoUrl,
        "width": 112,
        "height": 112
      },
      "founder": {
        "@type": "Person",
        "name": "Tedi Wintoko"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+62 821 7000 0575",
        "contactType": "technical support",
        "email": "busdev.sonus@solar-nusantara.id",
        "areaServed": "ID",
        "availableLanguage": "Indonesian"
      },
      "sameAs": [
        "https://instagram.com/solar_nusantara",
        "https://www.youtube.com/@Sonus.ID_",
        "https://www.linkedin.com/company/solar-nusantara/"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": `${baseUrl}/#localbusiness`,
      "name": "Solar Nusantara (PT Tripower Solar Nusantara)",
      "image": logoUrl,
      "telephone": "+62 821 7000 0575",
      "url": baseUrl,
      "areaServed": {
        "@type": "Country",
        "name": "Indonesia"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Gandaria Office 8 Tower lantai 8, Jl. Sultan Iskandar Muda No.8, RT.10/RW.6, Gandaria, Kec. Kby. Lama",
        "addressLocality": "Jakarta Selatan",
        "addressRegion": "DKI Jakarta",
        "postalCode": "12240",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -6.2443,
        "longitude": 106.7845
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "09:00",
        "closes": "17:00"
      }
    },
    {
       "@type": "WebSite",
       "@id": `${baseUrl}/#website`,
       "url": baseUrl,
       "name": "Solar Nusantara",
       "publisher": {
          "@id": `${baseUrl}/#organization`
       },
       "creator": {
          "@id": `${baseUrl}/#developer`
       }
    },
    {
      "@type": "Person",
      "@id": `${baseUrl}/#developer`,
      "name": "Mochammad Farros Fatchur Roji",
      "url": "https://farros.co",
      "jobTitle": "Cyber Security & Data Engineer",
      "sameAs": [
        "https://github.com/farrosfr",
        "https://linkedin.com/in/farrosfr",
        "https://medium.com/@farros",
        "https://dev.to/farros",
        "https://youtube.com/@farrosfr",
        "https://instagram.com/farrosfr"
      ]
    },
    // Page-level nodes supplied via the `jsonLd` prop (Article, BreadcrumbList,
    // FAQPage, ...). Merged into THIS graph on purpose so the page emits one
    // script tag, and so those nodes can reference #organization / #website by
    // @id instead of restating the publisher.
    ...jsonLd,
  ]
};
---

<!doctype html>
<!--
	lang was "en" until 2026-09-15 while every string the site ships is
	Indonesian - the tagline, the meta description, the navigation, the page
	copy. Declaring the wrong content language misleads search engines about
	which locale to serve the page to, and makes screen readers pronounce
	Indonesian text with English phonetics.
-->
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<title>{pageTitle}</title>

		<!-- Primary Meta Tags -->
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{/*
			Canonical is built from the configured `site` plus the pathname only.
			It used to be `Astro.url.href`, which carries the querystring and hash,
			so every campaign link (?utm_source=..., ?fbclid=...) self-declared a
			different canonical URL and split the signal for the same page.
		*/}
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={isMarkdownPage ? 'article' : 'website'}>
		<meta property="og:site_name" content={BRAND} />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={description} />
		{isMarkdownPage && frontmatter.pubDate && (
			<meta property="article:published_time" content={frontmatter.pubDate.toISOString()} />
		)}
		{isMarkdownPage && frontmatter.updatedDate && (
			<meta property="article:modified_time" content={frontmatter.updatedDate.toISOString()} />
		)}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={description} />

		{/*
			KaTeX CSS, loaded only on pages that actually contain math.

			The integrity hash here was wrong until 2026-09-15. It read
			`sha384-zh0CIuu+PnAe8mreGmxaC5YG8F4D0X94s4H/pTToz4fS2u1Tq2Vl/V1+72k6J4G8`
			while the file jsDelivr serves for katex@0.16.21 hashes to
			`sha384-zh0CIslj+VczCZtlzBcjt5ppRcsAmDnRem7ESsYwWwg3m/OaJ2l4x7YBZl9Kxxib`
			(verified by downloading it and running openssl dgst -sha384). Only the
			first few characters matched. Subresource Integrity is fail-closed, so
			the browser refused to apply the stylesheet on every page and the three
			articles with formulas rendered their math unstyled.

			If the pinned version is ever bumped, recompute the hash - do not edit
			the version and keep the old digest.
		*/}
		{needsKatex && (
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
				integrity="sha384-zh0CIslj+VczCZtlzBcjt5ppRcsAmDnRem7ESsYwWwg3m/OaJ2l4x7YBZl9Kxxib"
				crossorigin="anonymous"
			/>
		)}

		<!-- Structured Data -->

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
		<noscript>
		  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
		</noscript>
	</head>
	<body class="bg-white min-h-screen flex flex-col">
		<Header />
		<Navbar />
		<MobileHeader />
		
    {isMarkdownPage ? (
      // Smart Layout for .md pages
      <main class="flex-grow">
        <div class="container mx-auto px-4 py-16">
          {hasHeadings ? (
            // With Table of Contents
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
              <div class="flex-1 w-full lg:w-3/4">
                <article class="prose lg:prose-xl mx-auto">
                  <h1>{title}</h1>
                  <slot />
                </article>
              </div>
              <aside class="hidden lg:block lg:w-1/4 lg:sticky lg:top-24 self-start">
                <nav id="toc-nav" class="border-l-2 border-gray-200 pl-4">
                  <h2 class="font-bold text-lg mb-4 text-gray-800">Di Halaman ini</h2>
                  <ul class="space-y-2">
                    {headings.filter(h => h.depth === 2 || h.depth === 3).map(heading => (
                      <li>
                        <a href={`#${heading.slug}`} data-slug={heading.slug} class:list={["toc-link text-gray-500 hover:text-blue-600 transition-colors duration-200", { 'pl-4': heading.depth === 3 }]}>
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </aside>
            </div>
          ) : (
            // Without Table of Contents
            <article class="prose lg:prose-xl mx-auto">
              <h1>{title}</h1>
              <slot />
            </article>
          )}
        </div>
      </main>
    ) : (
      // Simple Layout for .astro pages
      <main class="flex-grow">
        <slot />
      </main>
    )}

		<Footer />

    {isMarkdownPage && hasHeadings && (
      <>
        {/* Mobile TOC Panel */}
        <aside id="mobile-toc" class="fixed top-0 right-0 h-full w-4/5 max-w-sm bg-white shadow-xl transform transition-transform duration-300 ease-in-out translate-x-full z-50 lg:hidden">
          <div class="p-4 flex justify-between items-center border-b">
            <h2 class="font-bold text-lg text-gray-800">Di Halaman ini</h2>
            <button id="close-mobile-toc" aria-label="Close table of contents" class="p-2 -mr-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <nav class="p-4">
            <ul class="space-y-2">
              {headings.filter(h => h.depth === 2 || h.depth === 3).map(heading => (
                <li>
                  <a href={`#${heading.slug}`} class="mobile-toc-link block py-2 text-gray-600 hover:text-blue-600" class:list={{ 'pl-4': heading.depth === 3 }}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        {/* Overlay */}
        <div id="mobile-toc-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden lg:hidden"></div>

        {/* Floating Action Button (FAB) */}
        <button id="open-mobile-toc" aria-label="Open table of contents" class="fixed bottom-4 right-3 lg:hidden w-14 h-14 bg-[#1583c7] text-gray-800 rounded-full shadow-lg flex items-center justify-center z-40 active:scale-95 transition-transform hover:bg-[#e0b633]">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 6.00067L21 6.00139M8 12.0007L21 12.0015M8 18.0007L21 18.0015M3.5 6H3.51M3.5 12H3.51M3.5 18H3.51M4 6C4 6.27614 3.77614 6.5 3.5 6.5C3.22386 6.5 3 6.27614 3 6C3 5.72386 3.22386 5.5 3.5 5.5C3.77614 5.5 4 5.72386 4 6ZM4 12C4 12.2761 3.77614 12.5 3.5 12.5C3.22386 12.5 3 12.2761 3 12C3 11.7239 3.22386 11.5 3.5 11.5C3.77614 11.5 4 11.7239 4 12ZM4 18C4 18.2761 3.77614 18.5 3.5 18.5C3.22386 18.5 3 18.2761 3 18C3 17.7239 3.22386 17.5 3.5 17.5C3.77614 17.5 4 17.7239 4 18Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </>
    )}

    {hasHeadings && (
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          // Desktop TOC scroll-spy
          const tocLinks = document.querySelectorAll('.toc-link');
          const headings = Array.from(document.querySelectorAll('h2, h3'));
          if (tocLinks.length > 0 && headings.length > 0) {
            const observer = new IntersectionObserver(entries => {
              entries.forEach(entry => {
                const slug = entry.target.id;
                const tocLink = document.querySelector(`.toc-link[data-slug="${slug}"]`);
                if (entry.isIntersecting) {
                  tocLinks.forEach(link => link.classList.remove('is-active'));
                  tocLink?.classList.add('is-active');
                }
              });
            }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
            headings.forEach(heading => observer.observe(heading));
          }

          // Mobile TOC functionality
          const openTocBtn = document.getElementById('open-mobile-toc');
          const closeTocBtn = document.getElementById('close-mobile-toc');
          const mobileTocPanel = document.getElementById('mobile-toc');
          const mobileTocOverlay = document.getElementById('mobile-toc-overlay');
          const mobileTocLinks = document.querySelectorAll('.mobile-toc-link');

          if (openTocBtn && mobileTocPanel && mobileTocOverlay && closeTocBtn) {
              const openMenu = () => {
                  mobileTocPanel.classList.remove('translate-x-full');
                  mobileTocOverlay.classList.remove('hidden');
                  document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
              };

              const closeMenu = () => {
                  mobileTocPanel.classList.add('translate-x-full');
                  mobileTocOverlay.classList.add('hidden');
                  document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
              };

              openTocBtn.addEventListener('click', openMenu);
              closeTocBtn.addEventListener('click', closeMenu);
              mobileTocOverlay.addEventListener('click', closeMenu);
              mobileTocLinks.forEach(link => {
                  link.addEventListener('click', closeMenu);
              });
          }
        });
      </script>
    )}

    <style is:global>
      .toc-link.is-active {
        @apply text-blue-600 font-semibold;
        transform: scale(1.05);
      }
    </style>
	</body>
</html>